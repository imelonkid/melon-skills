# 项目基线 v3 · NestJS 服务的环境变量（追加到项目 .env.example；真实值在 1Password ops/<名>/prod，经部署入口下发）
PORT=8080
# 数据库：节点共享 MySQL 实例上本项目自己的库与账号（见项目基线「数据库部署」）
DATABASE_URL=mysql://__NAME__:<密码>@<共享实例>:3306/__NAME__
# 可观测：服务名（日志 service 字段、OTel）；版本号 APP_VERSION 在镜像构建时注入，不写在这里
OTEL_SERVICE_NAME=__NAME__
OTEL_EXPORTER_OTLP_ENDPOINT=
# 用到 Redis（缓存、锁、BullMQ 队列）时再加：REDIS_URL=redis://<地址>:6379/0
